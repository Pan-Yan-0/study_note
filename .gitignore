# =========================
# Python / Jupyter Notebook
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# =========================
# Data & Model Files
# =========================
# Datasets (usually large)
*.csv
*.tsv
*.json
*.xml
*.parquet
*.db
*.sqlite
*.sqlite3

# Raw data directories
data/raw/
data/processed/
datasets/

# Model weights & checkpoints (often very large)
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
models/
checkpoints/

# =========================
# ML Experiment Tracking
# =========================
mlruns/
wandb/
tensorboard_logs/
logs/
runs/

# =========================
# IDE / Editor
# =========================
# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml

# Cursor
.cursor/

# =========================
# OS Generated Files
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =========================
# Temporary / Output Files
# =========================
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# Output / Results directories
output/
results/
dist/
build/

# =========================
# Secrets (never commit these!)
# =========================
.env
.env.local
.env.*.local
secrets.json
config.yaml
*.key
*.pem
